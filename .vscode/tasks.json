{
  // Terminal > Run Task... > "CoolAir: start everything" (server + USB bridge), or each one on its own
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CoolAir: start everything",
      "dependsOn": ["CoolAir: start", "CoolAir: bridge"],
      "problemMatcher": []
    },
    {
      "label": "CoolAir: bridge",
      "type": "shell",
      "command": "npm run bridge",
      "options": { "cwd": "${workspaceFolder}/coolair" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "CoolAir: start",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/coolair" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
